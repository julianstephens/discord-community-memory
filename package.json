{
  "name": "discord-community-memory",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "direnv exec . turbo run dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "build": "direnv exec . turbo run build",
    "build:clean": "direnv exec . turbo run clean:build"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.md": [
      "oxfmt --write"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
