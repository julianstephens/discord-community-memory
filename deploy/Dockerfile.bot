FROM ghcr.io/pnpm/pnpm:12.11.2 AS base
RUN pnpm runtime set node 24 -g
WORKDIR /app

FROM base AS prepare
RUN pnpm add --global turbo@2.11.7
COPY . .
RUN turbo prune bot --docker

FROM base AS builder
COPY --from=prepare /app/out/json/ ./
COPY --from=prepare /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=prepare /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN --mount=type=cache,id=community-memory-pnpm,target=/var/cache/pnpm \
    pnpm install --frozen-lockfile --store-dir /var/cache/pnpm

COPY --from=prepare /app/out/full/ ./
COPY --from=prepare /app/tsconfig.base.json /app/tsconfig.build.json /app/tsconfig.json ./
RUN --mount=type=cache,id=community-memory-turbo,target=/app/.turbo \
    pnpm exec turbo run build --filter=bot...
RUN --mount=type=cache,id=community-memory-pnpm,target=/var/cache/pnpm \
    pnpm --filter=bot deploy --prod --store-dir /var/cache/pnpm /prod/bot

FROM node:24-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /prod/bot/package.json ./package.json
COPY --from=builder --chown=node:node /prod/bot/node_modules ./node_modules
COPY --from=builder --chown=node:node /prod/bot/dist ./dist
USER node
CMD ["node", "dist/main.mjs"]
